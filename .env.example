# OPUS67 — Environment variables template
# Copy to .env.local and fill in real values locally.
# NEVER commit real secrets. Server-only variables must NOT use the NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# None required to boot the core application. OPUS67 degrades gracefully
# when optional providers are not configured.

# ---------------------------------------------------------------------------
# DATABASE (OPTIONAL — PostgreSQL, e.g. Neon or Supabase)
# ---------------------------------------------------------------------------
# When unset, the application runs with the in-memory repository
# (non-persistent; see docs/DATA_MODEL.md).
# DATABASE_URL="postgresql://user:password@host:5432/opus67?sslmode=require"

# ---------------------------------------------------------------------------
# PROVIDER-SPECIFIC (OPTIONAL — AI providers, server-side only)
# ---------------------------------------------------------------------------
# Generic selector for the active AI provider adapter.
# Supported values: "none" (default). Additional adapters: see docs/ROADMAP.md.
# AI_PROVIDER="none"

# Example placeholder for a future provider adapter (do not commit real keys):
# AI_PROVIDER_API_KEY="replace-me-locally-only"

# ---------------------------------------------------------------------------
# OBSERVABILITY (OPTIONAL)
# ---------------------------------------------------------------------------
# LOG_LEVEL="info"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://example-otel-collector.example.com"
